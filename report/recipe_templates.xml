<odoo>
    <template id="report_recipes">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <span t-field="o.image_1920"
                              t-options="{'widget': 'image', 'alt-field': 'name'}"
                              class="position-relative d-block rounded overflow-hidden z-1 shadow-sm"
                              t-att-title="o.name"
                              data-bs-toggle="tooltip"
                              data-bs-placement="top"
                              data-bs-delay="0"
                        />
<!--                        <div t-field="o.image_1920" class="d-block h-100 w-100 overflow-hidden ratio ratio-4x3"-->
<!--                t-options="{'widget': 'image', 'class': 'o_wappointment_cover_image object-fit-cover', 'preview_image': 'image_512'}"/>-->
                        <h2>
                            <span t-field="o.name"/>
                        </h2>
                        <div>
                        Preparation time : <span t-field="o.preparation_time"/>
                        Cost : <span t-field="o.price" widget="monetary"/>
                            </div>
                        <div>
                            <span t-field="o.price" widget="monetary"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>